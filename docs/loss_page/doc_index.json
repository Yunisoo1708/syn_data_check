{"text": "<meta name=\"dash-one-writer\">\n<style>\n.lp{display:flex;flex-direction:column;gap:var(--cds-gap-lg);max-width:920px}\n.lp h1{font-family:var(--font-anthropic-serif);font-weight:400;font-size:var(--cds-font-size-title);margin:0 0 var(--cds-gap-xs) 0}\n.lp .lead{margin:0;color:var(--color-fg-muted);font-size:var(--cds-font-size-body);line-height:1.5}\n.lp .lead b{color:var(--color-fg);font-weight:var(--cds-font-weight-medium);font-variant-numeric:tabular-nums}\n.lp .card{background:var(--color-panel);border:1px solid var(--color-border-line);border-radius:var(--cds-radius);padding:var(--cds-pad-lg);display:flex;flex-direction:column;gap:var(--cds-gap-sm);min-width:0}\n.lp h2{margin:0;font-size:var(--cds-font-size-heading);font-weight:var(--cds-font-weight-medium)}\n.lp .note{margin:0;color:var(--color-fg-muted);font-size:var(--cds-font-size-caption);line-height:1.45}\n.lp .chart{position:relative;min-height:270px}\n.lp .chart svg{display:block;width:100%;height:auto}\n.lp .chart svg text{fill:var(--cds-text-secondary);font-size:11px;font-family:var(--font-anthropic-sans)}\n.lp .tip{position:absolute;pointer-events:none;background:var(--cds-surface-popover);border:1px solid var(--cds-border);box-shadow:var(--cds-shadow-popover);color:var(--cds-text-secondary);font-size:12px;padding:6px 8px;border-radius:6px;white-space:nowrap;z-index:2}\n.lp .legend{display:flex;gap:var(--cds-gap-md);flex-wrap:wrap;font-size:var(--cds-font-size-caption);color:var(--color-fg-muted);margin-top:var(--cds-gap-xs)}\n.lp .legend i{display:inline-block;width:18px;height:0;border-top:2px solid;vertical-align:middle;margin-right:6px}\n.lp table{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums;font-size:var(--cds-font-size-caption)}\n.lp th,.lp td{text-align:right;padding:4px 8px;border-bottom:1px solid var(--color-border-line);white-space:nowrap}\n.lp th{font-weight:var(--cds-font-weight-medium);color:var(--color-fg-muted)}\n.lp th:first-child,.lp td:first-child{text-align:left}\n.lp .scroll{overflow-x:auto}\n</style>\n<div class=\"lp\">\n  <div>\n    <h1>Decoder training loss</h1>\n    <p class=\"lead\" id=\"lead\" data-draw=\"lead\" data-source=\"summary\"></p>\n  </div>\n  <section class=\"card\" id=\"complex-loss\">\n    <h2>Complex loss: training vs held-out families</h2>\n    <p class=\"note\">Lower is better. Held-out complexes come from protein families the model never trains on. If the held-out line rises while the training line keeps falling, the model is memorising the training complexes.</p>\n    <div class=\"chart\" data-draw=\"chartComplex\" data-source=\"loss\"></div>\n  </section>\n  <section class=\"card\" id=\"pool-loss\">\n    <h2>Pool loss: training vs held-out peptides</h2>\n    <p class=\"note\">The large peptide pool (46,379 files). This one should stay low for the whole run.</p>\n    <div class=\"chart\" data-draw=\"chartPool\" data-source=\"loss\"></div>\n  </section>\n  <section class=\"card\" id=\"epoch-table\">\n    <h2>Every epoch</h2>\n    <p class=\"note\">Newest first. The row marked saved is the epoch whose weights are kept.</p>\n    <div class=\"scroll\">\n      <table data-source=\"loss\" data-row-key=\"run,epoch\">\n        <thead><tr><th data-field=\"run\">Run</th><th data-field=\"epoch\">Epoch</th><th data-field=\"train_complex\">Train complex</th><th data-field=\"val_complex\">Held-out complex</th><th data-field=\"train_pool\">Train pool</th><th data-field=\"val_pool\">Held-out pool</th><th>Weights</th></tr></thead>\n        <tbody data-draw=\"rows\"></tbody>\n      </table>\n    </div>\n  </section>\n</div>\n<script>\ndash.calc('summary', {\n  title: 'Latest epoch and best held-out epoch',\n  description: 'The newest run in the file, its last epoch, the gap between held-out and training complex loss, and the epoch with the lowest held-out total loss.',\n  inputs: ['loss'],\n  fn: (loss) => {\n    if (!loss.length) return [];\n    const runs = [...new Set(loss.map((r) => r.run))];\n    const run = runs[runs.length - 1];\n    const rs = loss.filter((r) => r.run === run).sort((a, b) => a.epoch - b.epoch);\n    const last = rs[rs.length - 1];\n    let best = rs[0];\n    for (const r of rs) if (r.val_pool + r.val_complex < best.val_pool + best.val_complex) best = r;\n    return [{ run: run, epoch: last.epoch, val_complex: last.val_complex, train_complex: last.train_complex, gap: Math.round((last.val_complex - last.train_complex) * 1e5) / 1e5, best_epoch: best.epoch }];\n  }\n});\ndash.draw('lead', (el) => {\n  const s = dash.data('summary');\n  if (s.status !== 'ok' || !s.data.length) { el.textContent = '—'; return; }\n  const r = s.data[0];\n  const p = d3.select(el); p.text('');\n  const add = (t) => p.append('span').text(t);\n  const num = (f, v) => p.append('b').attr('data-source', 'summary').attr('data-field', f).attr('data-row', '0').text(v);\n  add(r.run + ' is at epoch '); num('epoch', r.epoch);\n  add('. Held-out complex loss '); num('val_complex', r.val_complex);\n  add(' against '); num('train_complex', r.train_complex);\n  add(' on training complexes (gap '); num('gap', r.gap);\n  add('). Lowest held-out total at epoch '); num('best_epoch', r.best_epoch); add('.');\n});\nfunction lineChart(el, trainKey, valKey, label) {\n  const g = dash.data('loss');\n  const root = d3.select(el);\n  if (g.status !== 'ok' || !g.data.length) { root.selectAll('*').remove(); el.textContent = g.status === 'error' ? 'Failed to load' : '—'; return; }\n  root.text('');\n  const rows = g.data, runs = [...new Set(rows.map((r) => r.run))];\n  const W = Math.max(300, el.clientWidth || 600), H = 270, m = { t: 12, r: 14, b: 34, l: 52 };\n  const maxE = d3.max(rows, (r) => r.epoch) || 1;\n  const x = d3.scaleLinear().domain([0, maxE]).range([m.l, W - m.r]);\n  const vals = rows.flatMap((r) => [r[trainKey], r[valKey]]).filter((v) => v != null);\n  const y = d3.scaleLinear().domain([0, (d3.max(vals) || 1) * 1.08]).nice().range([H - m.b, m.t]);\n  const svg = root.append('svg').attr('viewBox', '0 0 ' + W + ' ' + H).attr('role', 'img')\n    .attr('aria-label', label + ': training and held-out loss by epoch for ' + runs.join(', '));\n  svg.append('g').selectAll('line').data(y.ticks(5)).join('line').attr('x1', m.l).attr('x2', W - m.r).attr('y1', (d) => y(d)).attr('y2', (d) => y(d)).style('stroke', 'var(--cds-chart-grid)');\n  const ax = svg.append('g').attr('transform', 'translate(0,' + (H - m.b) + ')').call(d3.axisBottom(x).ticks(Math.min(10, maxE)).tickFormat(d3.format('d')));\n  const ay = svg.append('g').attr('transform', 'translate(' + m.l + ',0)').call(d3.axisLeft(y).ticks(5).tickFormat(d3.format('.3~f')));\n  [ax, ay].forEach((a) => { a.selectAll('path,line').style('stroke', 'var(--cds-chart-axis)'); a.selectAll('text').style('fill', 'var(--cds-text-secondary)'); });\n  svg.append('text').attr('x', (m.l + W - m.r) / 2).attr('y', H - 4).attr('text-anchor', 'middle').text('Epoch');\n  const series = [[trainKey, 0, 'Training'], [valKey, 1, 'Held-out']];\n  runs.forEach((run, ri) => {\n    const rs = rows.filter((r) => r.run === run).sort((a, b) => a.epoch - b.epoch);\n    const latest = ri === runs.length - 1;\n    series.forEach(([key, ci]) => {\n      const pts = rs.filter((r) => r[key] != null);\n      svg.append('path').datum(pts).attr('fill', 'none').style('stroke', dash.colors[ci]).attr('stroke-width', latest ? 2.2 : 1.5).attr('stroke-dasharray', latest ? null : '4 3').attr('opacity', latest ? 1 : 0.7)\n        .attr('d', d3.line().x((r) => x(r.epoch)).y((r) => y(r[key]))(pts));\n      if (latest) svg.append('g').selectAll('circle').data(pts).join('circle').attr('cx', (r) => x(r.epoch)).attr('cy', (r) => y(r[key])).attr('r', 2.6).style('fill', dash.colors[ci]);\n    });\n  });\n  const lg = root.append('div').attr('class', 'legend');\n  series.forEach(([k, ci, name]) => { const s = lg.append('span'); s.append('i').style('border-top-color', dash.colors[ci]); s.append('span').text(name); });\n  if (runs.length > 1) lg.append('span').text('Dashed = earlier run');\n  const tip = root.append('div').attr('class', 'tip').style('display', 'none');\n  svg.append('rect').attr('x', m.l).attr('y', m.t).attr('width', W - m.l - m.r).attr('height', H - m.t - m.b).attr('fill', 'transparent')\n    .on('mousemove', (ev) => {\n      const e = Math.max(0, Math.min(maxE, Math.round(x.invert(d3.pointer(ev, svg.node())[0]))));\n      const lines = [];\n      runs.forEach((run) => { const r = rows.find((q) => q.run === run && q.epoch === e); if (r) lines.push(run + ', epoch ' + e + ': training ' + (r[trainKey] == null ? '—' : r[trainKey]) + ', held-out ' + r[valKey]); });\n      if (!lines.length) { tip.style('display', 'none'); return; }\n      const box = el.getBoundingClientRect();\n      tip.style('display', 'block').text('').selectAll('div').data(lines).join('div').text((d) => d);\n      tip.style('left', Math.min(ev.clientX - box.left + 12, Math.max(0, box.width - 260)) + 'px').style('top', Math.max(0, ev.clientY - box.top - 40) + 'px');\n    })\n    .on('mouseleave', () => tip.style('display', 'none'));\n}\ndash.draw('chartComplex', (el) => lineChart(el, 'train_complex', 'val_complex', 'Complex loss'));\ndash.draw('chartPool', (el) => lineChart(el, 'train_pool', 'val_pool', 'Pool loss'));\ndash.draw('rows', (tb) => {\n  const g = dash.data('loss');\n  if (g.status !== 'ok') { tb.replaceChildren(); return; }\n  const runs = [...new Set(g.data.map((r) => r.run))];\n  const sorted = [...g.data].sort((a, b) => runs.indexOf(b.run) - runs.indexOf(a.run) || b.epoch - a.epoch);\n  const tr = d3.select(tb).selectAll('tr').data(sorted).join('tr');\n  tr.selectAll('td').data((r) => [r.run, r.epoch, r.train_complex, r.val_complex, r.train_pool, r.val_pool, r.best ? 'saved' : '']).join('td').text((d) => (d == null ? '—' : d));\n});\n</script>\n"}